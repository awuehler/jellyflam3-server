# Example Tailscale ACL fragment for JellyFlam3 flock peering (guide 05)
# and the Phase 5 LLM Agent Platform host (phase5/01).
# Paste into the tailnet policy file (admin console) — do not commit live keys.
#
# Furnaces (Opt In):
#   tailscale up --auth-key="$TS_AUTHKEY" --advertise-tags=tag:jellyflam3
#
# Agent platform (Ventuno — Tailscale only, no Syncthing):
#   tailscale up --auth-key="$TS_AUTHKEY_AGENT" --hostname=ventuno-jellyflam3-agent \
#     --advertise-tags=tag:jellyflam3-agent
#
# Use a **separate** tagged pre-auth key for the agent. Do not run
# `python3 -m pipeline.peering opt-in` on the Ventuno (that starts Syncthing).
#
# Tag owners and ACL editors must be restricted to flock admins.

{
  "tagOwners": {
    "tag:jellyflam3": ["autogroup:admin"],
    "tag:jellyflam3-agent": ["autogroup:admin"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["tag:jellyflam3"],
      "dst": ["tag:jellyflam3:*"]
    },
    {
      "action": "accept",
      "src": ["tag:jellyflam3-agent"],
      "dst": [
        "tag:jellyflam3:22",
        "tag:jellyflam3:8096",
        "tag:jellyflam3:8791"
      ]
    }
  ],
  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:admin"],
      "dst": ["tag:jellyflam3"],
      "users": ["jellyflam3", "autogroup:nonroot"]
    },
    {
      "action": "check",
      "src": ["autogroup:admin"],
      "dst": ["tag:jellyflam3-agent"],
      "users": ["jf3agent", "autogroup:nonroot"]
    }
  ]
}
