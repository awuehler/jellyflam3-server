[Unit]
Description=JellyFlam3 display-profile + sheep-vote sink (:8791)
After=network-online.target
Wants=network-online.target

# A non-loopback bind needs DISPLAY_SINK_TOKEN or JELLYFIN_API_KEY in secrets.env.
# Both empty → exit 2 → Restart=on-failure crash-loop. DISPLAY_SINK_TOKEN is optional
# (power-user sideload) and unique per furnace.
[Service]
Type=simple
User=jellyflam3
Group=jellyflam3
WorkingDirectory=/opt/jellyflam3-server
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/jellyflam3-server/secrets.env
ExecStart=/usr/bin/python3 -m pipeline.display_profile_sink --config /opt/jellyflam3-server/configs/jellyflam3.yaml --host 0.0.0.0 --port 8791
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
