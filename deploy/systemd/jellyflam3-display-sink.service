[Unit]
Description=JellyFlam3 display-profile + sheep-vote sink (:8791)
After=network-online.target
Wants=network-online.target

# DISPLAY_SINK_TOKEN in secrets.env is required: this unit binds 0.0.0.0.
# Empty token → exit 2 → Restart=on-failure crash-loop. Unique per furnace.
[Service]
Type=simple
User=jellyflam3
Group=jellyflam3
WorkingDirectory=/opt/jellyflam3-server
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/jellyflam3-server/secrets.env
ExecStart=/usr/bin/python3 -m pipeline.display_profile_sink --config /opt/jellyflam3-server/configs/jellyflam3.yaml --host 0.0.0.0 --port 8791
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
