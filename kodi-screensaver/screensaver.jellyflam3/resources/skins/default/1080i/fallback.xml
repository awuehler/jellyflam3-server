<?xml version="1.0" encoding="UTF-8"?>
<window>
  <!-- videowindow cannot take focus — use a hidden button as defaultcontrol -->
  <defaultcontrol always="true">90</defaultcontrol>
  <controls>
    <!-- Focus sink + underlay BEFORE videowindow (videowindow must be topmost). -->
    <control type="button" id="90">
      <description>focus sink (invisible; receives remote so onAction runs)</description>
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <texturefocus></texturefocus>
      <texturenofocus></texturenofocus>
      <label></label>
      <visible>true</visible>
    </control>
    <control type="image">
      <description>fullscreen black under video</description>
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>stretch</aspectratio>
      <texture colordiffuse="FF0A0A12">white.png</texture>
    </control>
    <control type="label" id="100">
      <left>0</left>
      <top>500</top>
      <width>1920</width>
      <height>80</height>
      <align>center</align>
      <aligny>center</aligny>
      <font>font13</font>
      <textcolor>88FFFFFF</textcolor>
      <visible>false</visible>
      <label>JellyFlam3</label>
    </control>
    <!-- Windowed Player; caption 101 overlays a chrome-light title strip -->
    <control type="videowindow" id="1">
      <description>loop player (windowed, no OSD chrome)</description>
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
    </control>
    <control type="label" id="101">
      <description>chrome-light filename/alias caption (Phase 4 / 09)</description>
      <left>80</left>
      <top>1016</top>
      <width>900</width>
      <height>48</height>
      <align>left</align>
      <aligny>center</aligny>
      <font>font13</font>
      <textcolor>8CE8E8F0</textcolor>
      <visible>false</visible>
      <label></label>
    </control>
    <control type="label" id="102">
      <description>vote key hint (Phase 5 / 05; last 7s)</description>
      <left>980</left>
      <top>1016</top>
      <width>860</width>
      <height>48</height>
      <align>right</align>
      <aligny>center</aligny>
      <font>font13</font>
      <textcolor>8CE8E8F0</textcolor>
      <visible>false</visible>
      <label></label>
    </control>
  </controls>
</window>
