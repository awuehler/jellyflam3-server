<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
  <script type="text/brightscript" uri="PlayerScreen.brs" />
  <interface>
    <function name="playSheep" />
    <function name="stopSheep" />
    <field id="close" type="boolean" alwaysNotify="true" />
    <field id="clipFinished" type="boolean" alwaysNotify="true" />
    <field id="playbackFailed" type="boolean" alwaysNotify="true" />
    <field id="allowShuffleAdvance" type="boolean" />
  </interface>
  <children>
    <Video
      id="Video"
      width="1920"
      height="1080"
      translation="[0,0]"
      loop="false"
      enableUI="false" />
    <Group
      id="playerChrome"
      translation="[80,920]"
      visible="false">
      <Rectangle
        id="chromeBanner"
        width="1760"
        height="52"
        color="0x0A0A128C" />
      <Label
        id="status"
        translation="[20,8]"
        width="1720"
        height="36"
        font="font:SmallSystemFont"
        color="0xE8E8F08C"
        horizAlign="left"
        wrap="false"
        visible="false"
        text="" />
      <Group id="voteOverlay" visible="false">
        <Label
          id="votePrompt"
          translation="[20,8]"
          width="700"
          height="36"
          font="font:SmallSystemFont"
          color="0xE8E8F08C"
          horizAlign="left"
          wrap="false"
          maxLines="1"
          ellipsizeOnBoundary="true"
          text="" />
        <Label
          id="voteHint"
          translation="[760,8]"
          width="980"
          height="36"
          font="font:SmallSystemFont"
          color="0xE8E8F08C"
          horizAlign="right"
          wrap="false"
          text="OK love · RIGHT like · DOWN dismiss · UP/BACK exit" />
      </Group>
    </Group>
    <Timer
      id="progressTimer"
      repeat="true"
      duration="10" />
    <Timer
      id="voteHideTimer"
      repeat="false"
      duration="7" />
  </children>
</component>
